-- SMOOTH ORBIT MURDERER
local orbitConnection
function EnableOrbitMurderer()
    OrbitMurdererEnabled = true
    local angle = 0
    local radius = 10
    local height = 2
    local speed = 0.05
    
    orbitConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not OrbitMurdererEnabled then
            if orbitConnection then
                orbitConnection:Disconnect()
            end
            return
        end
        
        if roles.Murder then
            local player = Players:FindFirstChild(roles.Murder)
            if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                angle = angle + speed
                
                local targetPos = player.Character.HumanoidRootPart.Position
                local x = targetPos.X + math.cos(angle) * radius
                local z = targetPos.Z + math.sin(angle) * radius
                local y = targetPos.Y + height
                
                local newCFrame = CFrame.new(x, y, z)
                local lookAt = CFrame.new(newCFrame.Position, targetPos)
                
                LP.Character.HumanoidRootPart.CFrame = lookAt
            end
        end
    end)
end

function DisableOrbitMurderer()
    OrbitMurdererEnabled = false
    if orbitConnection then
        orbitConnection:Disconnect()
    end
end

