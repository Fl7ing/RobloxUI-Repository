-- BYPASS SYSTEM FOR MOVEMENT
local function SetupBypass()
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        LP.Character.HumanoidRootPart.Anchored = false
        
        local humanoid = LP.Character:FindFirstChild("Humanoid")
        if humanoid then
            pcall(function()
                local mt = getrawmetatable(game)
                local oldIndex = mt.__index
                local oldNewIndex = mt.__newindex
                
                setreadonly(mt, false)
                
                mt.__newindex = newcclosure(function(t, k, v)
                    if t:IsA("Humanoid") and (k == "WalkSpeed" or k == "JumpPower") then
                        return
                    end
                    return oldNewIndex(t, k, v)
                end)
                
                setreadonly(mt, true)
            end)
        end
    end
end

-- BYPASS NOCLIP
local function BypassNoClip()
    if NoClip and LP.Character then
        for _, part in pairs(LP.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = false
            end
        end
        
        if LP.Character:FindFirstChild("HumanoidRootPart") then
            LP.Character.HumanoidRootPart.CanCollide = false
        end
    end
end

-- BYPASS SPEED
local function BypassSpeed(speed)
    if LP.Character and LP.Character:FindFirstChild("Humanoid") and SpeedBypass then
        local humanoid = LP.Character.Humanoid
        
        if speed > 16 then
            local moveDirection = humanoid.MoveDirection
            if moveDirection.Magnitude > 0 then
                local hrp = LP.Character.HumanoidRootPart
                local newCFrame = hrp.CFrame + (moveDirection * (speed / 16 - 1) * 0.5)
                
                local ray = Ray.new(newCFrame.Position, Vector3.new(0, -5, 0))
                local hit = workspace:FindPartOnRay(ray, LP.Character)
                
                if hit then
                    hrp.CFrame = newCFrame
                end
            end
        end
        
        humanoid.WalkSpeed = 16
    end
end

-- BYPASS FLY SYSTEM
local flyEnabled = false
local flyConnection

function EnableBypassFly()
    flyEnabled = true
    
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LP.Character.HumanoidRootPart
        
        local platform = Instance.new("Part")
        platform.Size = Vector3.new(10, 0.5, 10)
        platform.Transparency = 1
        platform.Anchored = true
        platform.CanCollide = true
        platform.Name = "FlyPlatform"
        platform.Parent = workspace
        
        flyConnection = RunService.Heartbeat:Connect(function()
            if not flyEnabled or not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then
                if platform then platform:Destroy() end
                return
            end
            
            local camera = workspace.CurrentCamera
            local moveDirection = Vector3.new(0, 0, 0)
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDirection = moveDirection + camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDirection = moveDirection - camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDirection = moveDirection - camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDirection = moveDirection + camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveDirection = moveDirection + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                moveDirection = moveDirection - Vector3.new(0, 1, 0)
            end
            
            if moveDirection.Magnitude > 0 then
                moveDirection = moveDirection.Unit
                hrp.CFrame = hrp.CFrame + (moveDirection * (FlySpeed / 50))
            end
            
            platform.CFrame = hrp.CFrame * CFrame.new(0, -3.5, 0)
            hrp.Velocity = Vector3.new(0, 0, 0)
        end)
    end
end

function DisableBypassFly()
    flyEnabled = false
    if flyConnection then
        flyConnection:Disconnect()
    end
    
    local platform = workspace:FindFirstChild("FlyPlatform")
    if platform then
        platform:Destroy()
    end
end

-- BYPASS FLING SYSTEM
function BypassFling(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    
    local char = LP.Character
    local targetChar = targetPlayer.Character
    
    if not char or not targetChar then return end
    if not char:FindFirstChild("HumanoidRootPart") or not targetChar:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local targetHRP = targetChar.HumanoidRootPart
    local originalCFrame = hrp.CFrame
    
    local flingPart = Instance.new("Part")
    flingPart.Size = Vector3.new(8, 8, 8)
    flingPart.Transparency = 1
    flingPart.CanCollide = true
    flingPart.Anchored = false
    flingPart.Name = "FlingBypass"
    flingPart.Parent = workspace
    
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.Massless = true
        end
    end
    
    local attachment0 = Instance.new("Attachment", hrp)
    local attachment1 = Instance.new("Attachment", flingPart)
    
    local alignPos = Instance.new("AlignPosition")
    alignPos.Attachment0 = attachment0
    alignPos.Attachment1 = attachment1
    alignPos.RigidityEnabled = true
    alignPos.ReactionForceEnabled = false
    alignPos.ApplyAtCenterOfMass = true
    alignPos.MaxForce = 9e9
    alignPos.MaxVelocity = 9e9
    alignPos.Responsiveness = 200
    alignPos.Parent = hrp
    
    local alignOri = Instance.new("AlignOrientation")
    alignOri.Attachment0 = attachment0
    alignOri.Attachment1 = attachment1
    alignOri.RigidityEnabled = true
    alignOri.ReactionTorqueEnabled = false
    alignOri.MaxTorque = 9e9
    alignOri.MaxAngularVelocity = 9e9
    alignOri.Responsiveness = 200
    alignOri.Parent = hrp
    
    task.spawn(function()
        for i = 1, 25 do
            task.wait()
            
            if not targetChar.Parent or not targetChar:FindFirstChild("HumanoidRootPart") then
                break
            end
            
            local direction = (targetHRP.Position - flingPart.Position).Unit
            flingPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
            flingPart.Velocity = direction * 300
            flingPart.RotVelocity = Vector3.new(100, 100, 100)
        end
        
        task.wait(0.5)
        pcall(function()
            alignPos:Destroy()
            alignOri:Destroy()
            attachment0:Destroy()
            attachment1:Destroy()
            flingPart:Destroy()
        end)
        
        hrp.CFrame = originalCFrame
        hrp.Velocity = Vector3.new(0, 0, 0)
        
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
                v.Massless = false
            end
        end
    end)
end

