local currentSongIndex = 1
local currentSound = nil

function DownloadAndPlaySong(songData)
    if not isfile(songData.file) then
        print("[BurmaldaMellstroyUIMM2] Downloading " .. songData.name .. "...")
        
        local success, response = pcall(function() 
            return game:HttpGet(songData.url) 
        end)
        
        if success and response then
            writefile(songData.file, response)
            print("[BurmaldaMellstroyUIMM2] " .. songData.name .. " downloaded!")
        else
            warn("[BurmaldaMellstroyUIMM2] Download error for " .. songData.name)
            return
        end
    end

    local success, audioData = pcall(function()
        return getcustomasset(songData.file)
    end)

    if success and audioData then
        if currentSound then
            currentSound:Destroy()
        end

        currentSound = Instance.new("Sound")
        currentSound.Name = "BurmaldaMusic"
        currentSound.SoundId = audioData
        currentSound.Volume = 2.5
        currentSound.Looped = true
        currentSound.Parent = game:GetService("CoreGui")

        if not currentSound.IsLoaded then 
            currentSound.Loaded:Wait() 
        end
        
        currentSound:Play()
        print("[BurmaldaMellstroyUIMM2] Playing: " .. songData.name)
    end
end

