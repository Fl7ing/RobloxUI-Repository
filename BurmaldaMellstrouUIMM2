-- Button Creation Function with RED text
local function CreateButton(name, position, parent, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = parent or OptionsFrame
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.BorderSizePixel = 0
    btn.Position = position
    btn.Size = UDim2.new(0.45, 0, 0, 30)
    btn.Font = Enum.Font.GothamBold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 50, 50) -- RED TEXT
    btn.TextSize = 12
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(callback)
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(255, 50, 50),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(35, 35, 35),
            TextColor3 = Color3.fromRGB(255, 50, 50)
        }):Play()
    end)
    
    return btn
end

