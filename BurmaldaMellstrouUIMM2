-- Main Loop
RunService.RenderStepped:Connect(function()
    local success, result = pcall(function()
        local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if getData then
            return getData:InvokeServer()
        end
    end)
    
    if success and result then
        local tempRoles = {}
        for name, data in pairs(result) do
            if data.Role == "Murderer" then
                tempRoles.Murder = name
            elseif data.Role == "Sheriff" then
                tempRoles.Sheriff = name
            elseif data.Role == "Hero" then
                tempRoles.Hero = name
            end
        end
        
        if tempRoles.Murder ~= roles.Murder or tempRoles.Sheriff ~= roles.Sheriff then
            roles = tempRoles
            UpdatePlayerList()
        end
        
        roles = result
    end
    
    UpdateESP()
end)

