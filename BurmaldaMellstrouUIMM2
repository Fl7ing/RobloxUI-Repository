-- Check if player is alive
function IsAlive(player)
    if not roles then return false end
    for name, data in pairs(roles) do
        if player.Name == name then
            return not data.Killed and not data.Dead
        end
    end
    return false
end

-- Create/Update Highlights
function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local highlight = player.Character:FindFirstChild("Highlight")
            
            if ESPEnabled and not highlight then
                highlight = Instance.new("Highlight")
                highlight.Parent = player.Character
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
            elseif not ESPEnabled and highlight then
                highlight:Destroy()
                continue
            end
            
            if highlight and IsAlive(player) then
                if roles.Murder == player.Name then
                    highlight.FillColor = Color3.fromRGB(225, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                elseif roles.Sheriff == player.Name then
                    highlight.FillColor = Color3.fromRGB(0, 0, 225)
                    highlight.OutlineColor = Color3.fromRGB(0, 100, 255)
                elseif roles.Hero == player.Name and roles.Sheriff and not IsAlive(Players:FindFirstChild(roles.Sheriff)) then
                    highlight.FillColor = Color3.fromRGB(255, 250, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 200, 0)
                else
                    highlight.FillColor = Color3.fromRGB(0, 225, 0)
                    highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
                end
            elseif highlight then
                highlight.FillColor = Color3.fromRGB(100, 100, 100)
                highlight.OutlineColor = Color3.fromRGB(150, 150, 150)
            end
        end
    end
end

-- Update Player List
function UpdatePlayerList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LP then
            local btn = CreatePlayerButton(player)
            
            if roles.Murder == player.Name then
                btn.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
            elseif roles.Sheriff == player.Name then
                btn.BackgroundColor3 = Color3.fromRGB(20, 20, 60)
            elseif roles.Hero == player.Name then
                btn.BackgroundColor3 = Color3.fromRGB(60, 60, 20)
            end
        end
    end
    
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

